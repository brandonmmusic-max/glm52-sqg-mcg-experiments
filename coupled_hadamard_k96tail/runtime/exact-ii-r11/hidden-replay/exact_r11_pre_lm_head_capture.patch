+    def _capture_pre_lm_head_prompt_hidden_states(
+        self,
+        hidden_states: torch.Tensor,
+        num_tokens_unpadded: int,
+    ) -> None:
+        """Persist final-normalized prompt states for offline LM-head replay."""
+        capture_dir = os.environ.get("VLLM_KLD_HIDDEN_CAPTURE_DIR")
+        if not capture_dir or not is_global_first_rank():
+            return
+
+        model = self.get_model()
+        normalize = getattr(model, "compute_pre_lm_head_hidden_states", None)
+        if normalize is None:
+            raise RuntimeError(
+                "VLLM_KLD_HIDDEN_CAPTURE_DIR requires a model that exposes "
+                "compute_pre_lm_head_hidden_states"
+            )
+
+        req_ids = list(self.input_batch.req_ids)
+        num_rows = int(num_tokens_unpadded)
+        logger.info(
+            "Pre-LM-head capture hook: directory=%s global_first=%s "
+            "requests=%d rows=%d hidden_shape=%s",
+            capture_dir,
+            is_global_first_rank(),
+            len(req_ids),
+            num_rows,
+            tuple(hidden_states.shape),
+        )
+        if len(req_ids) != 1 or num_rows != 2_048:
+            raise RuntimeError(
+                "Pre-LM-head capture requires one 2,048-row request; "
+                f"got requests={len(req_ids)} rows={num_rows}"
+            )
+
+        req_id = req_ids[0]
+        normalized = normalize(hidden_states[:num_rows])
+        if (
+            tuple(normalized.shape) != (2_048, 6_144)
+            or normalized.dtype != torch.bfloat16
+        ):
+            raise RuntimeError(
+                "Pre-LM-head capture requires BF16 [2048, 6144]; got "
+                f"shape={tuple(normalized.shape)} dtype={normalized.dtype}"
+            )
+
+        safe_req_id = "".join(
+            char if char.isalnum() or char in "-_." else "_"
+            for char in req_id
+        )
+        request_dir = Path(capture_dir) / safe_req_id
+        request_dir.mkdir(parents=True, exist_ok=True)
+        row_end = num_rows
+        output_path = request_dir / (
+            f"hidden.rows-000000-{row_end:06d}.safetensors"
+        )
+        if output_path.exists():
+            raise RuntimeError(
+                f"Refusing to overwrite pre-LM-head capture chunk: {output_path}"
+            )
+
+        normalized_cpu = normalized.detach().to(device="cpu").contiguous()
+        from safetensors.torch import save_file
+
+        temporary_path = output_path.with_suffix(output_path.suffix + ".tmp")
+        save_file(
+            {"hidden_states": normalized_cpu},
+            str(temporary_path),
+            metadata={
+                "request_id": req_id,
+                "row_start": "0",
+                "row_end": str(row_end),
+                "semantic_point": "after_final_rmsnorm_before_lm_head",
+            },
+        )
+        os.replace(temporary_path, output_path)
+        logger.info(
+            "Saved pre-LM-head rows [%d, %d) shape=%s to %s",
+            0,
+            row_end,
+            tuple(normalized_cpu.shape),
+            output_path,
+        )
+
