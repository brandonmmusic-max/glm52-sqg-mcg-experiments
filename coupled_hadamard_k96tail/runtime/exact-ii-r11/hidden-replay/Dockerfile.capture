# syntax=docker/dockerfile:1.7
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG BASE_IMAGE
LABEL ai.verdict.purpose="GLM-5.2 one-context pre-LM-head capture" \
      ai.verdict.capture.semantic-point="after-final-rmsnorm-before-lm-head" \
      ai.verdict.capture.base-image="${BASE_IMAGE}" \
      ai.verdict.capture.runtime-lineage="exact-infernal-invocation-r11-tpfix"

COPY hidden_replay/exact_r11_pre_lm_head_capture.patch.gz \
     /tmp/glm52-hidden-capture/exact_r11_pre_lm_head_capture.patch.gz

RUN set -eu; \
    gzip -dc /tmp/glm52-hidden-capture/exact_r11_pre_lm_head_capture.patch.gz \
      > /tmp/glm52-hidden-capture/exact_r11_pre_lm_head_capture.patch; \
    printf '%s  %s\n' \
      d2521df3bed23f311ccd16c5ad46a20d46ae0d5674e1c34dd976bb88ebf002fd \
      /tmp/glm52-hidden-capture/exact_r11_pre_lm_head_capture.patch \
      | sha256sum -c -; \
    site_packages="$(/opt/venv/bin/python -c \
      'import sysconfig; print(sysconfig.get_paths()["purelib"])')"; \
    for root in /opt/infernal-invocation/vllm/vllm "${site_packages}/vllm"; do \
      test -d "${root}"; \
      patch --directory="${root}" --strip=1 --fuzz=0 \
        --input=/tmp/glm52-hidden-capture/exact_r11_pre_lm_head_capture.patch; \
    done; \
    /opt/venv/bin/python -m py_compile \
      /opt/infernal-invocation/vllm/vllm/model_executor/models/glm4_moe.py \
      /opt/infernal-invocation/vllm/vllm/model_executor/models/deepseek_v2.py \
      /opt/infernal-invocation/vllm/vllm/v1/worker/gpu_model_runner.py \
      /opt/infernal-invocation/vllm/vllm/v1/worker/gpu/model_runner.py

COPY hidden_replay/export_glm52_lm_head.py \
     hidden_replay/finalize_glm52_hidden_capture.py \
     hidden_replay/compare_glm52_hidden_replay.py \
     /opt/glm52-hidden-replay/
