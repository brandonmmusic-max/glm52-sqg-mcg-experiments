+def _selected_w4a8_kernel() -> str:
+    kernel = os.environ.get("B12X_GLM_W4A8_KERNEL", "m128n64").strip().lower()
+    if kernel not in ("m64n8", "m128n64"):
+        raise ValueError("B12X_GLM_W4A8_KERNEL must be 'm64n8' (one-warp) or 'm128n64'")
+    return kernel
