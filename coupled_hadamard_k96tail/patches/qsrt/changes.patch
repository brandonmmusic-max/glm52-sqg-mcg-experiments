+) -> Tensor:
+    """Evaluate the model's exact coordinatewise gated activation.
+
+    Coupled Hadamard construction is valid for either activation because the
+    preactivation transform is inverted before this operation and the
+    postactivation transform is applied afterward.  Keeping the choice in the
+    immutable transform specification prevents a Kimi SiTU candidate from
+    being replayed accidentally under GLM's standard SwiGLU contract.
+    """
+
+    if gate.shape != up.shape:
+        raise ValueError("gate and up projections must have matching shapes")
+    if activation == "situ":
+        return situ(gate, up)
+    if activation == "silu":
+        return F.silu(gate) * up
+    raise ValueError(f"unsupported expert activation: {activation}")
 
 
